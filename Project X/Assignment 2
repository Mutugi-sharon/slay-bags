    <style>
      body {
        margin: 0;
        font-family: "Segoe UI", sans-serif;
        background: url("pink.jpeg") no-repeat center center fixed;
        background-size: cover;
        color: #333;
        line-height: 1.6;
      }
      body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.85);
        z-index: -1;
      }
      header {
        background: linear-gradient(to right, pink, hotpink);
