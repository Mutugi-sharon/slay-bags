    <style>
      body {
        margin: 0;
        font-family: "Segoe UI", sans-serif;
        background: url("pink.jpeg") no-repeat center center fixed;
        background-size: cover;
        color: #333;
        line-height: 1.6;
      }
      body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.85);
        z-index: -1;
      }
      header {
        background: linear-gradient(to right, deeppink, hotpink);
        padding: 40px 20px;
        text-align: center;
        color: white;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
      }
      header h1 {
        margin: 0;
        font-size: 2.5rem;
        letter-spacing: 2px;
      }
      header p {
        margin-top: 10px;
        font-style: italic;
        font-size: 1.2rem;
      }
      main {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
        text-align: center;
      }
      h2 {
        color: deeppink;
        margin-bottom: 20px;
      }
      .text-paragraph {
        margin: 15px auto;
        font-size: 16px;
        text-align: justify;
      }
      #highlighted-paragraph {
        margin: 25px auto;
        font-size: 17px;
        font-weight: bold;
        color: deeppink;
        background: #ffe6f2;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
      }
      #final-paragraph {
        margin: 25px auto;
        font-size: 16px;
        font-style: italic;
        color: purple;
      }
      .back-link {
        display: inline-block;
        background: deeppink;
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        margin-top: 30px;
        transition: background 0.3s;
      }
      .back-link:hover {
        background: black;
      }
      footer {
        background: linear-gradient(to right, pink, silver);
        padding: 20px;
        color: deeppink;
        font-weight: bold;
        text-align: center;
        margin-top: 40px;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Slay-Bags</h1>
      <p>Luxury. Style. Confidence.</p>
