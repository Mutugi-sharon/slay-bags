        text-align: center;
        color: deeppink;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
      }
      header h1 {
        margin: 0;
        font-size: 2.5rem;
        letter-spacing: 2px;
      }
      header p {
        margin-top: 10px;
        font-style: italic;
        font-size: 1.2rem;
      }
      main {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
        text-align: center;
      }
      h2 {
        color: deeppink;
        margin-bottom: 20px;
      }
      .text-paragraph {
        margin: 15px auto;
        font-size: 16px;
        text-align: justify;
      }
      #highlighted-paragraph {
        margin: 25px auto;
        font-size: 17px;
        font-weight: bold;
        color: deeppink;
        background: #ffe6f2;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
      }
      #final-paragraph {
        margin: 25px auto;
        font-size: 16px;
        font-style: italic;
        color: purple;
      }
      .back-link {
        display: inline-block;
        background: deeppink;
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        margin-top: 30px;
        transition: background 0.3s;
      }
      .back-link:hover {
        background: black;
      }
      footer {
        background: linear-gradient(to right, silver, pink);
        padding: 20px;
        color: deeppink;
        font-weight: bold;
        text-align: center;
        margin-top: 40px;
      }
