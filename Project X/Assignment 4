        margin: 25px auto;
        font-size: 17px;
        font-weight: bold;
        color: deeppink;
        background: #ffe6f2;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
      }

      #final-paragraph {
        margin: 25px auto;
        font-size: 16px;
        font-style: italic;
        color: purple;
      }

      .back-link {
        display: inline-block;
        background: deeppink;
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        margin-top: 30px;
        transition: background 0.3s;
      }
      .back-link:hover {
        background: black;
      }

      footer {
        background: linear-gradient(to right, silver, pink);
