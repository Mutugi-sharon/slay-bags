        font-style: italic;
        font-size: 1.1rem;
      }

      main {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
        text-align: center;
      }

      #main-title {
        color: purple;
        margin-bottom: 10px;
        font-size: 2rem;
      }
      .sub-title {
