<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Slay-Bags</title>
    <link rel="stylesheet" href="style.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav>
      <a href="index.html">Home</a>
      <a href="#">Shop</a>
      <a href="#">Offers</a>
      <a href="#">Contact</a>
    </nav>

    <header>
      <h1>SLAY-BAGS</h1>
      <p>Luxury. Style. Confidence.</p>
    </header>

    <section>
      <h2>Our Collection</h2>
      <p>
        Discover elegant and trendy bags designed to elevate your style in 2026.
      </p>
    </section>

    <section>
      <figure>
        <img
          src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=600&q=80"
        />
        <figcaption>Classic Handbag<br /><b>Ksh 3,500</b></figcaption>
      </figure>
      <figure>
        <img src="bag.jpeg" />
        <figcaption>Luxury Tote<br /><b>Ksh 5,000</b></figcaption>
      </figure>
      <figure>
        <img src="minipurse.jpeg" />
        <figcaption>Mini Purse<br /><b>Ksh 2,000</b></figcaption>
      </figure>
      <figure>
        <img src="travel.jpeg" />
        <figcaption>Travel Bag<br /><b>Ksh 6,000</b></figcaption>
      </figure>
      <figure>
        <img src="cross.jpeg" />
        <figcaption>Leather Crossbody<br /><b>Ksh 4,500</b></figcaption>
      </figure>
    </section>

    <section>
      <h2>Order Now</h2>
      <form>
        <input type="text" placeholder="Full Name" required />
        <input type="text" placeholder="Phone Number" required />
        <select required>
          <option>Select Bag</option>
          <option>Classic Handbag - Ksh 3,500</option>
          <option>Luxury Tote - Ksh 5,000</option>
          <option>Mini Purse - Ksh 2,000</option>
          <option>Travel Bag - Ksh 6,000</option>
          <option>Leather Crossbody - Ksh 4,500</option>
        </select>
        <input type="number" placeholder="Quantity" min="1" value="1" />
        <textarea placeholder="Delivery Address" required></textarea>
        <input type="submit" value="Place Order" />
      </form>
    </section>

    <footer>
      <p>© 2026 Slay-Bags</p>
      <p>Contact: +254 712 345 678</p>
      <p>Instagram: @slaybags</p>
    </footer>
  </body>
</html>
